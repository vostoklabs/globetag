# Local setup only. Never commit this file after filling it in.
APPWRITE_ENDPOINT=https://REGION.cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=
APPWRITE_API_KEY=
# Long group passphrase; 12+ characters. Change and redeploy to revoke access.
GROUP_CODE=
# Generate separate random values of at least 32 characters for both secrets.
SESSION_SECRET=
OWNER_KEY=
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
